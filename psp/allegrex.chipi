dispatch shift { sll, srl, rotr, sra, sllv, srlv, rotrv, srav }
dispatch arith {
    add, addu, sub, subu, slt, sltu, max, min, movz, movn, clz, clo, addi, addiu, slti, sltiu
}
dispatch logic { and, or, xor, nor, andi, ori, xori, lui }
dispatch muldiv { mult, multu, div, divu, madd, maddu, msub, msubu, mfhi, mthi, mflo, mtlo }
dispatch branch {
    jr, jalr, j, jal, beq, bne, blez, bgtz, beql, bnel, blezl, bgtzl, bltz, bgez, bltzl, bgezl,
    bltzal, bgezal, bltzall, bgezall
}
dispatch system { syscall, break, sync, cache, halt, mfc0, mtc0, cfc0, ctc0, eret, mfic, mtic }
