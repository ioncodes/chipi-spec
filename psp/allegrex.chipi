    mfc1, mtc1, cfc1, ctc1, bc1f, bc1t, bc1fl, bc1tl, add_s, sub_s, mul_s, div_s, sqrt_s, abs_s,
    mov_s, neg_s, round_w_s, trunc_w_s, ceil_w_s, floor_w_s, cvt_w_s, cvt_s_w, c_f_s, c_un_s, c_eq_s,
