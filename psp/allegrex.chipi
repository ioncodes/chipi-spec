    | "c.ole.s {fs}, {ft}"

c_ule_s op=0x11 [25:21]=0x10 [10:0]=0x37 ft:fpr[20:16] fs:fpr[15:11]
    | "c.ule.s {fs}, {ft}"

c_sf_s op=0x11 [25:21]=0x10 [10:0]=0x38 ft:fpr[20:16] fs:fpr[15:11]
    | "c.sf.s {fs}, {ft}"

