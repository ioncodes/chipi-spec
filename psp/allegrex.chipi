operand vcontrol = u8 {
    display(names {
        128 => "SPFX", 129 => "TPFX", 130 => "DPFX", 131 => "CC", 132 => "INF4", 133 => "RSV5", 134 => "RSV6", 135 => "REV",
        136 => "RCX0", 137 => "RCX1", 138 => "RCX2", 139 => "RCX3", 140 => "RCX4", 141 => "RCX5", 142 => "RCX6", 143 => "RCX7", _ => dec
    })
}

# Shift

sll op=0x00 [25:21]=0x0 [5:0]=0x0 rt:gpr[20:16] rd:gpr[15:11] sa:d5[10:6]
    | "sll {rd}, {rt}, {sa}"

srl op=0x00 [25:21]=0x0 [5:0]=0x2 rt:gpr[20:16] rd:gpr[15:11] sa:d5[10:6]
    | "srl {rd}, {rt}, {sa}"

rotr op=0x00 [25:21]=0x1 [5:0]=0x2 rt:gpr[20:16] rd:gpr[15:11] sa:d5[10:6]
    | "rotr {rd}, {rt}, {sa}"

sra op=0x00 [25:21]=0x0 [5:0]=0x3 rt:gpr[20:16] rd:gpr[15:11] sa:d5[10:6]
    | "sra {rd}, {rt}, {sa}"

sllv op=0x00 [10:0]=0x4 rs:gpr[25:21] rt:gpr[20:16] rd:gpr[15:11]
    | "sllv {rd}, {rt}, {rs}"

srlv op=0x00 [10:0]=0x6 rs:gpr[25:21] rt:gpr[20:16] rd:gpr[15:11]
    | "srlv {rd}, {rt}, {rs}"

rotrv op=0x00 [10:0]=0x46 rs:gpr[25:21] rt:gpr[20:16] rd:gpr[15:11]
    | "rotrv {rd}, {rt}, {rs}"

srav op=0x00 [10:0]=0x7 rs:gpr[25:21] rt:gpr[20:16] rd:gpr[15:11]
    | "srav {rd}, {rt}, {rs}"

# Arithmetic

add op=0x00 [10:0]=0x20 rs:gpr[25:21] rt:gpr[20:16] rd:gpr[15:11]
    | "add {rd}, {rs}, {rt}"

addu op=0x00 [10:0]=0x21 rs:gpr[25:21] rt:gpr[20:16] rd:gpr[15:11]
    | "addu {rd}, {rs}, {rt}"

sub op=0x00 [10:0]=0x22 rs:gpr[25:21] rt:gpr[20:16] rd:gpr[15:11]
    | "sub {rd}, {rs}, {rt}"

subu op=0x00 [10:0]=0x23 rs:gpr[25:21] rt:gpr[20:16] rd:gpr[15:11]
    | "subu {rd}, {rs}, {rt}"

slt op=0x00 [10:0]=0x2a rs:gpr[25:21] rt:gpr[20:16] rd:gpr[15:11]
    | "slt {rd}, {rs}, {rt}"

sltu op=0x00 [10:0]=0x2b rs:gpr[25:21] rt:gpr[20:16] rd:gpr[15:11]
    | "sltu {rd}, {rs}, {rt}"

max op=0x00 [10:0]=0x2c rs:gpr[25:21] rt:gpr[20:16] rd:gpr[15:11]
    | "max {rd}, {rs}, {rt}"

min op=0x00 [10:0]=0x2d rs:gpr[25:21] rt:gpr[20:16] rd:gpr[15:11]
    | "min {rd}, {rs}, {rt}"

movz op=0x00 [10:0]=0xa rs:gpr[25:21] rt:gpr[20:16] rd:gpr[15:11]
    | "movz {rd}, {rs}, {rt}"

movn op=0x00 [10:0]=0xb rs:gpr[25:21] rt:gpr[20:16] rd:gpr[15:11]
    | "movn {rd}, {rs}, {rt}"

clz op=0x00 [20:16]=0x0 [10:0]=0x16 rs:gpr[25:21] rd:gpr[15:11]
    | "clz {rd}, {rs}"

clo op=0x00 [20:16]=0x0 [10:0]=0x17 rs:gpr[25:21] rd:gpr[15:11]
    | "clo {rd}, {rs}"

addi op=0x08 rs:gpr[25:21] rt:gpr[20:16] imm16:simm16[15:0]
    | "addi {rt}, {rs}, {imm16}"

addiu op=0x09 rs:gpr[25:21] rt:gpr[20:16] imm16:simm16[15:0]
    | "addiu {rt}, {rs}, {imm16}"

slti op=0x0a rs:gpr[25:21] rt:gpr[20:16] imm16:simm16[15:0]
    | "slti {rt}, {rs}, {imm16}"

sltiu op=0x0b rs:gpr[25:21] rt:gpr[20:16] imm16:simm16[15:0]
    | "sltiu {rt}, {rs}, {imm16}"

# Logic

and op=0x00 [10:0]=0x24 rs:gpr[25:21] rt:gpr[20:16] rd:gpr[15:11]
    | "and {rd}, {rs}, {rt}"

or op=0x00 [10:0]=0x25 rs:gpr[25:21] rt:gpr[20:16] rd:gpr[15:11]
    | "or {rd}, {rs}, {rt}"

xor op=0x00 [10:0]=0x26 rs:gpr[25:21] rt:gpr[20:16] rd:gpr[15:11]
    | "xor {rd}, {rs}, {rt}"

nor op=0x00 [10:0]=0x27 rs:gpr[25:21] rt:gpr[20:16] rd:gpr[15:11]
    | "nor {rd}, {rs}, {rt}"

andi op=0x0c rs:gpr[25:21] rt:gpr[20:16] uimm:uimm16[15:0]
    | "andi {rt}, {rs}, {uimm}"

ori op=0x0d rs:gpr[25:21] rt:gpr[20:16] uimm:uimm16[15:0]
    | "ori {rt}, {rs}, {uimm}"

xori op=0x0e rs:gpr[25:21] rt:gpr[20:16] uimm:uimm16[15:0]
    | "xori {rt}, {rs}, {uimm}"

lui op=0x0f [25:21]=0x0 rt:gpr[20:16] uimm:uimm16[15:0]
    upper:x32 = uimm << 16
    | "lui {rt}, {uimm}"

# Multiply / divide

mult op=0x00 [15:0]=0x18 rs:gpr[25:21] rt:gpr[20:16]
    | "mult {rs}, {rt}"

multu op=0x00 [15:0]=0x19 rs:gpr[25:21] rt:gpr[20:16]
    | "multu {rs}, {rt}"

div op=0x00 [15:0]=0x1a rs:gpr[25:21] rt:gpr[20:16]
    | "div {rs}, {rt}"

divu op=0x00 [15:0]=0x1b rs:gpr[25:21] rt:gpr[20:16]
    | "divu {rs}, {rt}"

madd op=0x00 [15:0]=0x1c rs:gpr[25:21] rt:gpr[20:16]
    | "madd {rs}, {rt}"

maddu op=0x00 [15:0]=0x1d rs:gpr[25:21] rt:gpr[20:16]
    | "maddu {rs}, {rt}"

msub op=0x00 [15:0]=0x2e rs:gpr[25:21] rt:gpr[20:16]
    | "msub {rs}, {rt}"

msubu op=0x00 [15:0]=0x2f rs:gpr[25:21] rt:gpr[20:16]
    | "msubu {rs}, {rt}"

mfhi op=0x00 [25:16]=0x0 [10:0]=0x10 rd:gpr[15:11]
    | "mfhi {rd}"

mthi op=0x00 [20:0]=0x11 rs:gpr[25:21]
    | "mthi {rs}"

mflo op=0x00 [25:16]=0x0 [10:0]=0x12 rd:gpr[15:11]
    | "mflo {rd}"

mtlo op=0x00 [20:0]=0x13 rs:gpr[25:21]
    | "mtlo {rs}"

# Jump and branch

jr op=0x00 [20:0]=0x8 rs:gpr[25:21]
    | "jr {rs}"

jalr op=0x00 [20:16]=0x0 [10:0]=0x9 rs:gpr[25:21] rd:gpr[15:11]
    | "jalr {rd}, {rs}"

j op=0x02 target:jtarget[25:0]
    | "j {target}"

jal op=0x03 target:jtarget[25:0]
    | "jal {target}"

beq op=0x04 rs:gpr[25:21] rt:gpr[20:16] offset:branch[15:0]
    | "beq {rs}, {rt}, {offset}"

bne op=0x05 rs:gpr[25:21] rt:gpr[20:16] offset:branch[15:0]
    | "bne {rs}, {rt}, {offset}"

blez op=0x06 [20:16]=0x0 rs:gpr[25:21] offset:branch[15:0]
    | "blez {rs}, {offset}"

bgtz op=0x07 [20:16]=0x0 rs:gpr[25:21] offset:branch[15:0]
    | "bgtz {rs}, {offset}"

beql op=0x14 rs:gpr[25:21] rt:gpr[20:16] offset:branch[15:0]
    | "beql {rs}, {rt}, {offset}"

bnel op=0x15 rs:gpr[25:21] rt:gpr[20:16] offset:branch[15:0]
    | "bnel {rs}, {rt}, {offset}"

blezl op=0x16 [20:16]=0x0 rs:gpr[25:21] offset:branch[15:0]
    | "blezl {rs}, {offset}"

bgtzl op=0x17 [20:16]=0x0 rs:gpr[25:21] offset:branch[15:0]
    | "bgtzl {rs}, {offset}"

bltz op=0x01 [20:16]=0x0 rs:gpr[25:21] offset:branch[15:0]
    | "bltz {rs}, {offset}"

bgez op=0x01 [20:16]=0x1 rs:gpr[25:21] offset:branch[15:0]
    | "bgez {rs}, {offset}"

bltzl op=0x01 [20:16]=0x2 rs:gpr[25:21] offset:branch[15:0]
    | "bltzl {rs}, {offset}"

bgezl op=0x01 [20:16]=0x3 rs:gpr[25:21] offset:branch[15:0]
    | "bgezl {rs}, {offset}"

bltzal op=0x01 [20:16]=0x10 rs:gpr[25:21] offset:branch[15:0]
    | "bltzal {rs}, {offset}"

bgezal op=0x01 [20:16]=0x11 rs:gpr[25:21] offset:branch[15:0]
    | "bgezal {rs}, {offset}"

bltzall op=0x01 [20:16]=0x12 rs:gpr[25:21] offset:branch[15:0]
    | "bltzall {rs}, {offset}"

bgezall op=0x01 [20:16]=0x13 rs:gpr[25:21] offset:branch[15:0]
    | "bgezall {rs}, {offset}"

# System

syscall op=0x00 [5:0]=0xc code:x20[25:6]
    | "syscall {code}"

break op=0x00 [5:0]=0xd code:x20[25:6]
    | "break {code}"

sync op=0x00 [25:11]=0x0 [5:0]=0xf stype:d5[10:6]
    | "sync {stype}"

cache op=0x2f rs:gpr[25:21] cache_op:x5[20:16] disp:simm16[15:0]
    | "cache {cache_op}, {disp}({rs})"

mfc0 op=0x10 [25:21]=0x0 [10:0]=0x0 rt:gpr[20:16] rd:cop0Register[15:11]
    | "mfc0 {rt}, {rd}"

mtc0 op=0x10 [25:21]=0x4 [10:0]=0x0 rt:gpr[20:16] rd:cop0Register[15:11]
    | "mtc0 {rt}, {rd}"

eret op=0x10 [25:0]=0x2000018
    | "eret"

# Load / store

lb op=0x20 rs:gpr[25:21] rt:gpr[20:16] disp:simm16[15:0]
    | "lb {rt}, {disp}({rs})"

lh op=0x21 rs:gpr[25:21] rt:gpr[20:16] disp:simm16[15:0]
    | "lh {rt}, {disp}({rs})"

lwl op=0x22 rs:gpr[25:21] rt:gpr[20:16] disp:simm16[15:0]
    | "lwl {rt}, {disp}({rs})"

lw op=0x23 rs:gpr[25:21] rt:gpr[20:16] disp:simm16[15:0]
    | "lw {rt}, {disp}({rs})"

lbu op=0x24 rs:gpr[25:21] rt:gpr[20:16] disp:simm16[15:0]
    | "lbu {rt}, {disp}({rs})"

lhu op=0x25 rs:gpr[25:21] rt:gpr[20:16] disp:simm16[15:0]
    | "lhu {rt}, {disp}({rs})"

lwr op=0x26 rs:gpr[25:21] rt:gpr[20:16] disp:simm16[15:0]
    | "lwr {rt}, {disp}({rs})"

sb op=0x28 rs:gpr[25:21] rt:gpr[20:16] disp:simm16[15:0]
    | "sb {rt}, {disp}({rs})"

sh op=0x29 rs:gpr[25:21] rt:gpr[20:16] disp:simm16[15:0]
    | "sh {rt}, {disp}({rs})"

swl op=0x2a rs:gpr[25:21] rt:gpr[20:16] disp:simm16[15:0]
    | "swl {rt}, {disp}({rs})"

sw op=0x2b rs:gpr[25:21] rt:gpr[20:16] disp:simm16[15:0]
    | "sw {rt}, {disp}({rs})"

swr op=0x2e rs:gpr[25:21] rt:gpr[20:16] disp:simm16[15:0]
    | "swr {rt}, {disp}({rs})"

ll op=0x30 rs:gpr[25:21] rt:gpr[20:16] disp:simm16[15:0]
    | "ll {rt}, {disp}({rs})"

sc op=0x38 rs:gpr[25:21] rt:gpr[20:16] disp:simm16[15:0]
    | "sc {rt}, {disp}({rs})"

# Bit field

ext op=0x1f [5:0]=0x0 rs:gpr[25:21] rt:gpr[20:16] size_minus_one:d5[15:11] pos:d5[10:6]
    size:d6 = size_minus_one + 1
    ext_mask:x32 = ones(size_minus_one + 1)
    when pos + size_minus_one < 32
    | "ext {rt}, {rs}, {pos}, {size}"

ins op=0x1f [5:0]=0x4 rs:gpr[25:21] rt:gpr[20:16] msb:d5[15:11] pos:d5[10:6]
    ins_size:d6 = msb - pos + 1
    ins_mask:x32 = ones(msb + 1) ^ ones(pos)
    when msb >= pos
    | "ins {rt}, {rs}, {pos}, {ins_size}"

seb op=0x1f [25:21]=0x0 [10:0]=0x420 rt:gpr[20:16] rd:gpr[15:11]
    | "seb {rd}, {rt}"

seh op=0x1f [25:21]=0x0 [10:0]=0x620 rt:gpr[20:16] rd:gpr[15:11]
    | "seh {rd}, {rt}"

wsbh op=0x1f [25:21]=0x0 [10:0]=0xa0 rt:gpr[20:16] rd:gpr[15:11]
    | "wsbh {rd}, {rt}"

wsbw op=0x1f [25:21]=0x0 [10:0]=0xe0 rt:gpr[20:16] rd:gpr[15:11]
    | "wsbw {rd}, {rt}"

bitrev op=0x1f [25:21]=0x0 [10:0]=0x520 rt:gpr[20:16] rd:gpr[15:11]
    | "bitrev {rd}, {rt}"

# FPU

mfc1 op=0x11 [25:21]=0x0 [10:0]=0x0 rt:gpr[20:16] fs:fpr[15:11]
    | "mfc1 {rt}, {fs}"

mtc1 op=0x11 [25:21]=0x4 [10:0]=0x0 rt:gpr[20:16] fs:fpr[15:11]
    | "mtc1 {rt}, {fs}"

cfc1 op=0x11 [25:21]=0x2 [10:0]=0x0 rt:gpr[20:16] fcr:fpuControlRegister[15:11]
    | "cfc1 {rt}, {fcr}"

ctc1 op=0x11 [25:21]=0x6 [10:0]=0x0 rt:gpr[20:16] fcr:fpuControlRegister[15:11]
    | "ctc1 {rt}, {fcr}"

bc1f op=0x11 [25:16]=0x100 offset:branch[15:0]
    | "bc1f {offset}"

bc1t op=0x11 [25:16]=0x101 offset:branch[15:0]
    | "bc1t {offset}"

bc1fl op=0x11 [25:16]=0x102 offset:branch[15:0]
    | "bc1fl {offset}"

bc1tl op=0x11 [25:16]=0x103 offset:branch[15:0]
    | "bc1tl {offset}"

add_s op=0x11 [25:21]=0x10 [5:0]=0x0 ft:fpr[20:16] fs:fpr[15:11] fd:fpr[10:6]
    | "add.s {fd}, {fs}, {ft}"

sub_s op=0x11 [25:21]=0x10 [5:0]=0x1 ft:fpr[20:16] fs:fpr[15:11] fd:fpr[10:6]
    | "sub.s {fd}, {fs}, {ft}"

mul_s op=0x11 [25:21]=0x10 [5:0]=0x2 ft:fpr[20:16] fs:fpr[15:11] fd:fpr[10:6]
    | "mul.s {fd}, {fs}, {ft}"

div_s op=0x11 [25:21]=0x10 [5:0]=0x3 ft:fpr[20:16] fs:fpr[15:11] fd:fpr[10:6]
    | "div.s {fd}, {fs}, {ft}"

sqrt_s op=0x11 [25:16]=0x200 [5:0]=0x4 fs:fpr[15:11] fd:fpr[10:6]
    | "sqrt.s {fd}, {fs}"

abs_s op=0x11 [25:16]=0x200 [5:0]=0x5 fs:fpr[15:11] fd:fpr[10:6]
    | "abs.s {fd}, {fs}"

mov_s op=0x11 [25:16]=0x200 [5:0]=0x6 fs:fpr[15:11] fd:fpr[10:6]
    | "mov.s {fd}, {fs}"

neg_s op=0x11 [25:16]=0x200 [5:0]=0x7 fs:fpr[15:11] fd:fpr[10:6]
    | "neg.s {fd}, {fs}"

round_w_s op=0x11 [25:16]=0x200 [5:0]=0xc fs:fpr[15:11] fd:fpr[10:6]
    | "round.w.s {fd}, {fs}"

trunc_w_s op=0x11 [25:16]=0x200 [5:0]=0xd fs:fpr[15:11] fd:fpr[10:6]
    | "trunc.w.s {fd}, {fs}"

ceil_w_s op=0x11 [25:16]=0x200 [5:0]=0xe fs:fpr[15:11] fd:fpr[10:6]
    | "ceil.w.s {fd}, {fs}"

floor_w_s op=0x11 [25:16]=0x200 [5:0]=0xf fs:fpr[15:11] fd:fpr[10:6]
    | "floor.w.s {fd}, {fs}"

cvt_w_s op=0x11 [25:16]=0x200 [5:0]=0x24 fs:fpr[15:11] fd:fpr[10:6]
    | "cvt.w.s {fd}, {fs}"

cvt_s_w op=0x11 [25:16]=0x280 [5:0]=0x20 fs:fpr[15:11] fd:fpr[10:6]
    | "cvt.s.w {fd}, {fs}"

c_f_s op=0x11 [25:21]=0x10 [10:0]=0x30 ft:fpr[20:16] fs:fpr[15:11]
    | "c.f.s {fs}, {ft}"

c_un_s op=0x11 [25:21]=0x10 [10:0]=0x31 ft:fpr[20:16] fs:fpr[15:11]
    | "c.un.s {fs}, {ft}"

c_eq_s op=0x11 [25:21]=0x10 [10:0]=0x32 ft:fpr[20:16] fs:fpr[15:11]
    | "c.eq.s {fs}, {ft}"

c_ueq_s op=0x11 [25:21]=0x10 [10:0]=0x33 ft:fpr[20:16] fs:fpr[15:11]
    | "c.ueq.s {fs}, {ft}"

c_olt_s op=0x11 [25:21]=0x10 [10:0]=0x34 ft:fpr[20:16] fs:fpr[15:11]
    | "c.olt.s {fs}, {ft}"

c_ult_s op=0x11 [25:21]=0x10 [10:0]=0x35 ft:fpr[20:16] fs:fpr[15:11]
    | "c.ult.s {fs}, {ft}"

