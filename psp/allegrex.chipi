c_ngt_s op=0x11 [25:21]=0x10 [10:0]=0x3f ft:fpr[20:16] fs:fpr[15:11]
    | "c.ngt.s {fs}, {ft}"

lwc1 op=0x31 rs:gpr[25:21] ft:fpr[20:16] disp:simm16[15:0]
    | "lwc1 {ft}, {disp}({rs})"

swc1 op=0x39 rs:gpr[25:21] ft:fpr[20:16] disp:simm16[15:0]
    | "swc1 {ft}, {disp}({rs})"

# PSP system and debug instructions

halt op=0x1c [25:0]=0x0
    | "halt"

dret op=0x1c [25:0]=0x3e
    | "dret"

dbreak op=0x1c [25:0]=0x3f
    | "dbreak"

cfc0 op=0x10 [25:21]=0x2 [10:0]=0x0 rt:gpr[20:16] rd:cop0Register[15:11]
    | "cfc0 {rt}, {rd}"

ctc0 op=0x10 [25:21]=0x6 [10:0]=0x0 rt:gpr[20:16] rd:cop0Register[15:11]
    | "ctc0 {rt}, {rd}"

mfic op=0x1c [25:21]=0x0 [10:0]=0x24 rt:gpr[20:16] rd:cop0Register[15:11]
