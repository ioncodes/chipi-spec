decoder Allegrex {
    width = 32
    bit_order = lsb0
    endian = little
}

selector op [31:26]

operand gpr = u5 {
    display(names {
        0 => "zero", 1 => "at", 2 => "v0", 3 => "v1", 4 => "a0", 5 => "a1", 6 => "a2", 7 => "a3",
        8 => "t0", 9 => "t1", 10 => "t2", 11 => "t3", 12 => "t4", 13 => "t5", 14 => "t6", 15 => "t7",
        16 => "s0", 17 => "s1", 18 => "s2", 19 => "s3", 20 => "s4", 21 => "s5", 22 => "s6", 23 => "s7",
        24 => "t8", 25 => "t9", 26 => "k0", 27 => "k1", 28 => "gp", 29 => "sp", 30 => "fp", 31 => "ra", _ => dec
    })
}

operand cop0Register       = u5 { display("c0_{}") }
operand fpr                = u5 { display("f{}") }
operand fpuControlRegister = u5 { display("fcr{}") }
operand debug_reg          = u5 { display("dr{}") }

operand d1 = u1 { display(dec) }
operand d2 = u2 { display(dec) }
operand d3 = u3 { display(dec) }
operand d5 = u5 { display(dec) }
operand d6 = u6 { display(dec) }
operand d7 = u7 { display(dec) }
operand d8 = u8 { display(dec) }
operand x5 = u5 { display(hex) }
operand x20 = u20 { display(hex) }
operand x24 = u24 { display(hex) }
operand x32 = u32 { display(hex) }

type uimm16  = u16 { display(hex) }
type simm16  = i32 { sign_extend(16), display(signed_hex) }
type branch  = i32 { shift_left(2), sign_extend(18), display(signed_hex) }
type vdisp14 = i32 { shift_left(2), sign_extend(16), display(signed_hex) }
type jtarget = u32 { zero_extend(26), shift_left(2), display(hex) }

