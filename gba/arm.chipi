# Single Data Transfer (LDR, STR)
form MemoryImmediate {
    cond:cc[31:28]
    pre:bool[24]
    up:bool[23]
    byte:bool[22]
    write:bool[21]
    rn:reg[19:16]
    rd:reg[15:12]
    off12:u12[11:0]
}

form MemoryRegister {
    cond:cc[31:28]
    pre:bool[24]
    up:bool[23]
    byte:bool[22]
    write:bool[21]
    rn:reg[19:16]
    rd:reg[15:12]
    shift_imm:u5[11:7]
    shift:shift_kind[6:5]
    rm:reg[3:0]
}

str.mem_imm op=0b010 [20]=0 uses MemoryImmediate
            when cond != 0xF
            | pre : "str{cond}{byte?b}{pre == 0 && write?t} {rd}, [{rn}, #{up?:-}{off12}]{write?!}"
            | "str{cond}{byte?b}{pre == 0 && write?t} {rd}, [{rn}], #{up?:-}{off12}"

str.mem_reg op=0b011 [20]=0 [4]=0 uses MemoryRegister
            when cond != 0xF && rm < 15
            amount:shift_amount = shift_imm == 0 && (shift == 1 || shift == 2) ? 32 : shift_imm
            | pre && shift == 0 && shift_imm == 0 : "str{cond}{byte?b}{pre == 0 && write?t} {rd}, [{rn}, {up?:-}{rm}]{write?!}"
            | pre && shift == 3 && shift_imm == 0 : "str{cond}{byte?b}{pre == 0 && write?t} {rd}, [{rn}, {up?:-}{rm}, rrx]{write?!}"
            | pre : "str{cond}{byte?b}{pre == 0 && write?t} {rd}, [{rn}, {up?:-}{rm}, {shift} #{amount}]{write?!}"
            | shift == 0 && shift_imm == 0 : "str{cond}{byte?b}{pre == 0 && write?t} {rd}, [{rn}], {up?:-}{rm}"
            | shift == 3 && shift_imm == 0 : "str{cond}{byte?b}{pre == 0 && write?t} {rd}, [{rn}], {up?:-}{rm}, rrx"
            | "str{cond}{byte?b}{pre == 0 && write?t} {rd}, [{rn}], {up?:-}{rm}, {shift} #{amount}"

ldr.mem_imm op=0b010 [20]=1 uses MemoryImmediate
            when cond != 0xF
            | pre : "ldr{cond}{byte?b}{pre == 0 && write?t} {rd}, [{rn}, #{up?:-}{off12}]{write?!}"
            | "ldr{cond}{byte?b}{pre == 0 && write?t} {rd}, [{rn}], #{up?:-}{off12}"

ldr.mem_reg op=0b011 [20]=1 [4]=0 uses MemoryRegister
            when cond != 0xF && rm < 15
            amount:shift_amount = shift_imm == 0 && (shift == 1 || shift == 2) ? 32 : shift_imm
            | pre && shift == 0 && shift_imm == 0 : "ldr{cond}{byte?b}{pre == 0 && write?t} {rd}, [{rn}, {up?:-}{rm}]{write?!}"
            | pre && shift == 3 && shift_imm == 0 : "ldr{cond}{byte?b}{pre == 0 && write?t} {rd}, [{rn}, {up?:-}{rm}, rrx]{write?!}"
            | pre : "ldr{cond}{byte?b}{pre == 0 && write?t} {rd}, [{rn}, {up?:-}{rm}, {shift} #{amount}]{write?!}"
            | shift == 0 && shift_imm == 0 : "ldr{cond}{byte?b}{pre == 0 && write?t} {rd}, [{rn}], {up?:-}{rm}"
            | shift == 3 && shift_imm == 0 : "ldr{cond}{byte?b}{pre == 0 && write?t} {rd}, [{rn}], {up?:-}{rm}, rrx"
            | "ldr{cond}{byte?b}{pre == 0 && write?t} {rd}, [{rn}], {up?:-}{rm}, {shift} #{amount}"

# Halfword and Signed Data Transfer(LDRH/STRH/LDRSB/LDRSH)
form HalfwordImmediate {
    cond:cc[31:28]
    pre:bool[24]
    up:bool[23]
    write:bool[21]
    rn:reg[19:16]
    rd:reg[15:12]
    off_hi:u4[11:8]
    off_lo:u4[3:0]
}

form HalfwordRegister {
    cond:cc[31:28]
    pre:bool[24]
    up:bool[23]
    write:bool[21]
    rn:reg[19:16]
    rd:reg[15:12]
    rm:reg[3:0]
}

strh.half_imm op=0b000 [20]=0 [7]=1 [6:5]=0b01 [4]=1 [22]=1 uses HalfwordImmediate
              when cond != 0xF && (pre || write == 0)
              half_offset:u8 = (off_hi << 4) + off_lo
              | pre : "str{cond}h {rd}, [{rn}, #{up?:-}{half_offset}]{write?!}"
              | "str{cond}h {rd}, [{rn}], #{up?:-}{half_offset}"

strh.half_reg op=0b000 [20]=0 [7]=1 [6:5]=0b01 [4]=1 [22]=0 [11:8]=0 uses HalfwordRegister
              when cond != 0xF && (pre || write == 0) && rm < 15
              | pre : "str{cond}h {rd}, [{rn}, {up?:-}{rm}]{write?!}"
              | "str{cond}h {rd}, [{rn}], {up?:-}{rm}"

ldrh.half_imm op=0b000 [20]=1 [7]=1 [6:5]=0b01 [4]=1 [22]=1 uses HalfwordImmediate
              when cond != 0xF && (pre || write == 0)
              half_offset:u8 = (off_hi << 4) + off_lo
              | pre : "ldr{cond}h {rd}, [{rn}, #{up?:-}{half_offset}]{write?!}"
              | "ldr{cond}h {rd}, [{rn}], #{up?:-}{half_offset}"

ldrh.half_reg op=0b000 [20]=1 [7]=1 [6:5]=0b01 [4]=1 [22]=0 [11:8]=0 uses HalfwordRegister
              when cond != 0xF && (pre || write == 0) && rm < 15
              | pre : "ldr{cond}h {rd}, [{rn}, {up?:-}{rm}]{write?!}"
              | "ldr{cond}h {rd}, [{rn}], {up?:-}{rm}"

ldrsb.half_imm op=0b000 [20]=1 [7]=1 [6:5]=0b10 [4]=1 [22]=1 uses HalfwordImmediate
               when cond != 0xF && (pre || write == 0)
               half_offset:u8 = (off_hi << 4) + off_lo
               | pre : "ldr{cond}sb {rd}, [{rn}, #{up?:-}{half_offset}]{write?!}"
               | "ldr{cond}sb {rd}, [{rn}], #{up?:-}{half_offset}"

ldrsb.half_reg op=0b000 [20]=1 [7]=1 [6:5]=0b10 [4]=1 [22]=0 [11:8]=0 uses HalfwordRegister
               when cond != 0xF && (pre || write == 0) && rm < 15
               | pre : "ldr{cond}sb {rd}, [{rn}, {up?:-}{rm}]{write?!}"
               | "ldr{cond}sb {rd}, [{rn}], {up?:-}{rm}"

ldrsh.half_imm op=0b000 [20]=1 [7]=1 [6:5]=0b11 [4]=1 [22]=1 uses HalfwordImmediate
               when cond != 0xF && (pre || write == 0)
               half_offset:u8 = (off_hi << 4) + off_lo
               | pre : "ldr{cond}sh {rd}, [{rn}, #{up?:-}{half_offset}]{write?!}"
               | "ldr{cond}sh {rd}, [{rn}], #{up?:-}{half_offset}"

ldrsh.half_reg op=0b000 [20]=1 [7]=1 [6:5]=0b11 [4]=1 [22]=0 [11:8]=0 uses HalfwordRegister
               when cond != 0xF && (pre || write == 0) && rm < 15
               | pre : "ldr{cond}sh {rd}, [{rn}, {up?:-}{rm}]{write?!}"
               | "ldr{cond}sh {rd}, [{rn}], {up?:-}{rm}"

# Block Data Transfer (LDM, STM)
stm op=0b100 cond:cc[31:28] pre:bool[24] up:bool[23] user:bool[22] write:bool[21] [20]=0 rn:reg[19:16] list:u16[15:0]
    when cond != 0xF && rn < 15
    | "stm{cond}{up?i:d}{pre?b:a} {rn}{write?!}, \\{{list & 0x1?r0}{list & 0x2?{list & 0x1?, }r1}{list & 0x4?{list & 0x3?, }r2}{list & 0x8?{list & 0x7?, }r3}{list & 0x10?{list & 0xf?, }r4}{list & 0x20?{list & 0x1f?, }r5}{list & 0x40?{list & 0x3f?, }r6}{list & 0x80?{list & 0x7f?, }r7}{list & 0x100?{list & 0xff?, }r8}{list & 0x200?{list & 0x1ff?, }r9}{list & 0x400?{list & 0x3ff?, }r10}{list & 0x800?{list & 0x7ff?, }r11}{list & 0x1000?{list & 0xfff?, }r12}{list & 0x2000?{list & 0x1fff?, }r13}{list & 0x4000?{list & 0x3fff?, }r14}{list & 0x8000?{list & 0x7fff?, }r15}\\}{user?^}"

ldm op=0b100 cond:cc[31:28] pre:bool[24] up:bool[23] user:bool[22] write:bool[21] [20]=1 rn:reg[19:16] list:u16[15:0]
    when cond != 0xF && rn < 15
    | "ldm{cond}{up?i:d}{pre?b:a} {rn}{write?!}, \\{{list & 0x1?r0}{list & 0x2?{list & 0x1?, }r1}{list & 0x4?{list & 0x3?, }r2}{list & 0x8?{list & 0x7?, }r3}{list & 0x10?{list & 0xf?, }r4}{list & 0x20?{list & 0x1f?, }r5}{list & 0x40?{list & 0x3f?, }r6}{list & 0x80?{list & 0x7f?, }r7}{list & 0x100?{list & 0xff?, }r8}{list & 0x200?{list & 0x1ff?, }r9}{list & 0x400?{list & 0x3ff?, }r10}{list & 0x800?{list & 0x7ff?, }r11}{list & 0x1000?{list & 0xfff?, }r12}{list & 0x2000?{list & 0x1fff?, }r13}{list & 0x4000?{list & 0x3fff?, }r14}{list & 0x8000?{list & 0x7fff?, }r15}\\}{user?^}"

# Single Data Swap (SWP)
swp op=0b000 cond:cc[31:28] [24:23]=0b10 byte:bool[22] [21:20]=0 rn:reg[19:16] rd:reg[15:12] [11:4]=0b00001001 rm:reg[3:0]
    when cond != 0xF && rn < 15 && rd < 15 && rm < 15
    | "swp{cond}{byte?b} {rd}, {rm}, [{rn}]"

# Software Interrupt (SWI)
swi op=0b111 cond:cc[31:28] [24]=1 comment:u24[23:0]
    when cond != 0xF
    | "swi{cond} #{comment}"

dispatch data_processing {
    and.*, eor.*, sub.*, rsb.*, add.*, adc.*, sbc.*, rsc.*,
    tst.*, teq.*, cmp.*, cmn.*, orr.*, mov.*, bic.*, mvn.*
}
dispatch psr_transfer { mrs, msr.* }
dispatch multiply_long { umull, umlal, smull, smlal }
dispatch single_transfer { ldr.mem_imm, ldr.mem_reg, str.mem_imm, str.mem_reg }
dispatch halfword_transfer { strh.*, ldrh.*, ldrsb.*, ldrsh.* }
dispatch block_transfer { ldm, stm }
