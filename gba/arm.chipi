decoder ARM {
    width     = 32
    bit_order = lsb0
    endian    = little
}

selector op [27:25]

operand reg = u4 { display("r{}") }
operand shift_amount = u8 { display(dec) }
operand branch_offset = i32 { sign_extend(24), shift_left(2), display(signed_hex) }
operand psr_name = u1 { display(names { 0 => "cpsr", 1 => "spsr", _ => hex }) }
operand cc = u4 {
    display(names {
        0x0 => "eq", 0x1 => "ne", 0x2 => "cs", 0x3 => "cc",
        0x4 => "mi", 0x5 => "pl", 0x6 => "vs", 0x7 => "vc",
        0x8 => "hi", 0x9 => "ls", 0xA => "ge", 0xB => "lt",
        0xC => "gt", 0xD => "le", 0xE => "", _ => hex
    })
}
operand shift_kind = u2 {
    display(names {
        0 => "lsl", 1 => "lsr", 2 => "asr", 3 => "ror", _ => hex 
    })
}


# Branch and Exchange (BX)
bx op=0b000 cond:cc[31:28] [24:4]=0b1_0010_1111_1111_1111_0001 rm:reg[3:0]
   when cond != 0xF
   | "bx{cond} {rm}"

# Branch and Branch with Link (B, BL)
b op=0b101 cond:cc[31:28] link:bool[24] offset:branch_offset[23:0]
  when cond != 0xF
  | "b{link?l}{cond} {offset}"

# PSR Transfer (MRS, MSR)
mrs op=0b000 cond:cc[31:28] [24:23]=0b10 psr:psr_name[22] [21:16]=0b001111 rd:reg[15:12] [11:0]=0
    when cond != 0xF && rd != 15
    | "mrs{cond} {rd}, {psr}"

msr.psr_reg op=0b000 cond:cc[31:28] [24:23]=0b10 psr:psr_name[22] [21:20]=0b10 mask:u4[19:16] [15:12]=0b1111 [11:4]=0 rm:reg[3:0]
            when cond != 0xF && mask != 0 && rm != 15
            | "msr{cond} {psr}_{mask & 8?f}{mask & 4?s}{mask & 2?x}{mask & 1?c}, {rm}"

msr.psr_imm op=0b001 cond:cc[31:28] [24:23]=0b10 psr:psr_name[22] [21:20]=0b10 mask:u4[19:16] [15:12]=0b1111 rotate:u4[11:8] imm8:u8[7:0]
            when cond != 0xF && mask != 0
            imm:u32 = rotate_right(imm8, rotate * 2, 32)
            | "msr{cond} {psr}_{mask & 8?f}{mask & 4?s}{mask & 2?x}{mask & 1?c}, #{imm}"

# Multiply and Multiply-Accumulate (MUL, MLA)
multiply op=0b000 cond:cc[31:28] [24:22]=0b000 a:bool[21] s:bool[20] dest:reg[19:16] acc:reg[15:12] rs:reg[11:8] [7:4]=0b1001 rm:reg[3:0]
         when cond != 0xF && dest < 15 && acc < 15 && rs < 15 && rm < 15 && dest != rm && (a || acc == 0)
         | "{a?mla:mul}{cond}{s?s} {dest}, {rm}, {rs}{a?, {acc}}"


# Multiply Long and Multiply-Accumulate Long (MULL,MLAL)
umull op=0b000 cond:cc[31:28] [24:21]=0b0100 s:bool[20] hi:reg[19:16] lo:reg[15:12] rs:reg[11:8] [7:4]=0b1001 rm:reg[3:0]
      when cond != 0xF && hi < 15 && lo < 15 && rs < 15 && rm < 15 && hi != lo && hi != rm && lo != rm
      | "umull{cond}{s?s} {lo}, {hi}, {rm}, {rs}"

umlal op=0b000 cond:cc[31:28] [24:21]=0b0101 s:bool[20] hi:reg[19:16] lo:reg[15:12] rs:reg[11:8] [7:4]=0b1001 rm:reg[3:0]
      when cond != 0xF && hi < 15 && lo < 15 && rs < 15 && rm < 15 && hi != lo && hi != rm && lo != rm
      | "umlal{cond}{s?s} {lo}, {hi}, {rm}, {rs}"

smull op=0b000 cond:cc[31:28] [24:21]=0b0110 s:bool[20] hi:reg[19:16] lo:reg[15:12] rs:reg[11:8] [7:4]=0b1001 rm:reg[3:0]
      when cond != 0xF && hi < 15 && lo < 15 && rs < 15 && rm < 15 && hi != lo && hi != rm && lo != rm
      | "smull{cond}{s?s} {lo}, {hi}, {rm}, {rs}"

smlal op=0b000 cond:cc[31:28] [24:21]=0b0111 s:bool[20] hi:reg[19:16] lo:reg[15:12] rs:reg[11:8] [7:4]=0b1001 rm:reg[3:0]
      when cond != 0xF && hi < 15 && lo < 15 && rs < 15 && rm < 15 && hi != lo && hi != rm && lo != rm
      | "smlal{cond}{s?s} {lo}, {hi}, {rm}, {rs}"

# Data Processing
form DataImmediate {
    cond:cc[31:28]
    s:bool[20]
    rn:reg[19:16]
    rd:reg[15:12]
    rotate:u4[11:8]
    imm8:u8[7:0]
}

form DataShiftImmediate {
    cond:cc[31:28]
    s:bool[20]
    rn:reg[19:16]
    rd:reg[15:12]
    shift_imm:u5[11:7]
    shift:shift_kind[6:5]
    rm:reg[3:0]
}

form DataShiftRegister {
    cond:cc[31:28]
    s:bool[20]
    rn:reg[19:16]
    rd:reg[15:12]
    rs:reg[11:8]
    shift:shift_kind[6:5]
    rm:reg[3:0]
}

and.imm op=0b001 [24:21]=0b0000 uses DataImmediate
        when cond != 0xF
        imm:u32 = rotate_right(imm8, rotate * 2, 32)
        | "and{cond}{s?s} {rd}, {rn}, #{imm}"

and.reg_imm op=0b000 [24:21]=0b0000 [4]=0 uses DataShiftImmediate
            when cond != 0xF
            amount:shift_amount = shift_imm == 0 && (shift == 1 || shift == 2) ? 32 : shift_imm
            | shift == 0 && shift_imm == 0 : "and{cond}{s?s} {rd}, {rn}, {rm}"
            | shift == 3 && shift_imm == 0 : "and{cond}{s?s} {rd}, {rn}, {rm}, rrx"
            | "and{cond}{s?s} {rd}, {rn}, {rm}, {shift} #{amount}"

and.reg_reg op=0b000 [24:21]=0b0000 [7]=0 [4]=1 uses DataShiftRegister
            when cond != 0xF
            | "and{cond}{s?s} {rd}, {rn}, {rm}, {shift} {rs}"

eor.imm op=0b001 [24:21]=0b0001 uses DataImmediate
        when cond != 0xF
        imm:u32 = rotate_right(imm8, rotate * 2, 32)
        | "eor{cond}{s?s} {rd}, {rn}, #{imm}"

