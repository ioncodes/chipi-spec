            when cond != 0xF
            amount:shift_amount = shift_imm == 0 && (shift == 1 || shift == 2) ? 32 : shift_imm
            | shift == 0 && shift_imm == 0 : "eor{cond}{s?s} {rd}, {rn}, {rm}"
            | shift == 3 && shift_imm == 0 : "eor{cond}{s?s} {rd}, {rn}, {rm}, rrx"
            | "eor{cond}{s?s} {rd}, {rn}, {rm}, {shift} #{amount}"

eor.reg_reg op=0b000 [24:21]=0b0001 [7]=0 [4]=1 uses DataShiftRegister
            when cond != 0xF
            | "eor{cond}{s?s} {rd}, {rn}, {rm}, {shift} {rs}"

